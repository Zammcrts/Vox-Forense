<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Audio</IRI><Literal xml:lang="es">Audio</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Audio</IRI><Literal xml:lang="es">Grabación de audio de voz sujeta a análisis forense.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AudioAutentico</IRI><Literal xml:lang="es">Audio auténtico</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AudioAutentico</IRI><Literal xml:lang="es">Audio producido por la voz de una persona real (etiqueta de referencia).</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AudioSintetico</IRI><Literal xml:lang="es">Audio sintético</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AudioSintetico</IRI><Literal xml:lang="es">Audio generado o modificado por un modelo de síntesis de voz (etiqueta de referencia).</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AudioSinteticoPorVocoderGAN</IRI><Literal xml:lang="es">Audio sintético por vocoder GAN</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AudioSinteticoPorVocoderGAN</IRI><Literal xml:lang="es">Audio sintético generado con un vocoder GAN.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AudioSinteticoPorTTS</IRI><Literal xml:lang="es">Audio sintético por TTS</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AudioSinteticoPorTTS</IRI><Literal xml:lang="es">Audio sintético generado con síntesis de texto a voz.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AudioSinteticoPorClonacion</IRI><Literal xml:lang="es">Audio sintético por clonación</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AudioSinteticoPorClonacion</IRI><Literal xml:lang="es">Audio sintético generado con clonación de voz.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AudioSinteticoPorConversion</IRI><Literal xml:lang="es">Audio sintético por conversión</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AudioSinteticoPorConversion</IRI><Literal xml:lang="es">Audio sintético generado con conversión de voz.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AudioSospechoso</IRI><Literal xml:lang="es">Audio sospechoso</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AudioSospechoso</IRI><Literal xml:lang="es">Audio con al menos una característica que es indicio de deepfake (clasificado por razonador).</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AudioSospechosoDeVocoderGAN</IRI><Literal xml:lang="es">Audio sospechoso de vocoder GAN</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AudioSospechosoDeVocoderGAN</IRI><Literal xml:lang="es">Audio sospechoso cuyos indicios apuntan a un vocoder GAN.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AudioConRasgosDeNaturalidad</IRI><Literal xml:lang="es">Audio con rasgos de naturalidad</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AudioConRasgosDeNaturalidad</IRI><Literal xml:lang="es">Audio con al menos un rasgo compatible con voz humana natural.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AudioConEvidenciaContradictoria</IRI><Literal xml:lang="es">Audio con evidencia contradictoria</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AudioConEvidenciaContradictoria</IRI><Literal xml:lang="es">Audio con indicios de deepfake y rasgos de naturalidad a la vez.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AudioQueRequiereRevisionHumana</IRI><Literal xml:lang="es">Audio que requiere revisión humana</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AudioQueRequiereRevisionHumana</IRI><Literal xml:lang="es">Audio cuyo caso debe escalarse a un analista forense.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Caracteristica</IRI><Literal xml:lang="es">Característica</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Caracteristica</IRI><Literal xml:lang="es">Medida extraida del audio (vector de caracteristicas).</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#CaracteristicaEspectral</IRI><Literal xml:lang="es">Característica espectral</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#CaracteristicaEspectral</IRI><Literal xml:lang="es">Medida derivada del espectro o del espectrograma mel.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#CentroideEspectral</IRI><Literal xml:lang="es">Centroide espectral</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#CentroideEspectral</IRI><Literal xml:lang="es">Centro de masa del espectro.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#PlanitudEspectral</IRI><Literal xml:lang="es">Planitud espectral</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#PlanitudEspectral</IRI><Literal xml:lang="es">Relación entre media geometrica y aritmetica del espectro (0 a 1).</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#EnergiaDeAltaFrecuencia</IRI><Literal xml:lang="es">Energía de alta frecuencia</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#EnergiaDeAltaFrecuencia</IRI><Literal xml:lang="es">Proporcion de energía en bandas de alta frecuencia.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#CaracteristicaProsodica</IRI><Literal xml:lang="es">Característica prosódica</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#CaracteristicaProsodica</IRI><Literal xml:lang="es">Medida de entonación, ritmo o microperturbaciones de la voz.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Jitter</IRI><Literal xml:lang="es">Jitter</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Jitter</IRI><Literal xml:lang="es">Variación ciclo a ciclo del periodo fundamental (fracción).</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#Shimmer</IRI><Literal xml:lang="es">Shimmer</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#Shimmer</IRI><Literal xml:lang="es">Variación ciclo a ciclo de la amplitud (fracción).</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#VariabilidadDeF0</IRI><Literal xml:lang="es">Variabilidad de F0</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#VariabilidadDeF0</IRI><Literal xml:lang="es">Coeficiente de variación de la frecuencia fundamental.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#CaracteristicaEstadistica</IRI><Literal xml:lang="es">Característica estadística</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#CaracteristicaEstadistica</IRI><Literal xml:lang="es">Estadistico resumen del espectrograma mel.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#EstadisticaPorBandaMel</IRI><Literal xml:lang="es">Estadística por banda mel</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#EstadisticaPorBandaMel</IRI><Literal xml:lang="es">Estadistico calculado sobre una banda mel concreta.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#CaracteristicaDePicosYMesetas</IRI><Literal xml:lang="es">Característica de picos Y mesetas</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#CaracteristicaDePicosYMesetas</IRI><Literal xml:lang="es">Medida de picos y mesetas del espectro.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#ProporcionDeMeseta</IRI><Literal xml:lang="es">Proporcion de meseta</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#ProporcionDeMeseta</IRI><Literal xml:lang="es">Fracción del espectro con comportamiento de meseta.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#ConteoDePicos</IRI><Literal xml:lang="es">Conteo de picos</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#ConteoDePicos</IRI><Literal xml:lang="es">Número de picos espectrales detectados.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#IndicioDeDeepfake</IRI><Literal xml:lang="es">Indicio de deepfake</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#IndicioDeDeepfake</IRI><Literal xml:lang="es">Característica anómala asociada a tecnicas de síntesis.</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#PatronDeMeseta</IRI><Literal xml:lang="es">Patron de meseta</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#PatronDeMeseta</IRI><Literal xml:lang="es">Proporcion de meseta alta (&gt;= 0.60).</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#AnomaliaDeAltaFrecuencia</IRI><Literal xml:lang="es">Anomalía de alta frecuencia</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#AnomaliaDeAltaFrecuencia</IRI><Literal xml:lang="es">Indicio calibrado con datos: hf_energy con valor mayor que 0.00258312 (en el audio sintético el valor tiende a ser alto).</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#JitterAnomalo</IRI><Literal xml:lang="es">Jitter anómalo</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#JitterAnomalo</IRI><Literal xml:lang="es">Indicio calibrado con datos: jitter con valor menor que 0.0226123 (en el audio sintético el valor tiende a ser bajo).</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#ShimmerAnomalo</IRI><Literal xml:lang="es">Shimmer anómalo</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#ShimmerAnomalo</IRI><Literal xml:lang="es">Shimmer demasiado bajo (&lt; 0.01).</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:label"/><IRI>#PlanitudEspectralAnomala</IRI><Literal xml:lang="es">Planitud espectral anómala</Literal></AnnotationAssertion>
<AnnotationAssertion><AnnotationProperty abbreviatedIRI="rdfs:comment"/><IRI>#PlanitudEspectralAnomala</IRI><Literal xml:lang="es">Planitud espectral alta (&gt;= 0.30).</Literal></AnnotationAssertion>
